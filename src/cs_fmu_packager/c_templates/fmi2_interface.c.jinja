FMI2_Export fmi2Component fmi2Instantiate(
    fmi2String instanceName, fmi2Type fmuType,
    fmi2String fmuGUID, fmi2String fmuResourceLocation,
    const fmi2CallbackFunctions* functions,
    fmi2Boolean visible, fmi2Boolean loggingOn) {

    if (fmuType != fmi2CoSimulation) return NULL;
    if (strcmp(fmuGUID, FMU_GUID) != 0) return NULL;

    WrapperInstance* inst = (WrapperInstance*)calloc(1, sizeof(WrapperInstance));
    if (!inst) return NULL;

    inst->callbacks = (fmi2CallbackFunctions*)functions;
    inst->instanceName = instanceName;
    inst->startTime = 0.0;
    inst->currentTime = 0.0;
    inst->stepSize = {{ step_size }};
    inst->communicationStepSize = {{ communication_step }};
    inst->nFMUs = {{ internal_fmus|length }};

    /* Allocate internal FMU storage */
    inst->FMUs = (InternalInstance*)calloc(inst->nFMUs, sizeof(InternalInstance));
    if (!inst->FMUs) { free(inst); return NULL; }

    /* Log initialization */
    if (functions && functions->logger) {
        functions->logger(functions->componentEnvironment, instanceName,
                          fmi2OK, "init", "Wrapper instantiated with %d internal FMU(s)",
                          inst->nFMUs);
    }

    wrapperInstance = inst;
    return (fmi2Component)inst;
}

FMI2_Export void fmi2FreeInstance(fmi2Component c) {
    if (!c) return;
    WrapperInstance* inst = (WrapperInstance*)c;
    for (int i = 0; i < inst->nFMUs; i++) {
        if (inst->FMUs[i].component && inst->FMUs[i].freeInstance) {
            inst->FMUs[i].freeInstance(inst->FMUs[i].component);
        }
        if (inst->FMUs[i].libHandle) {
            dlclose(inst->FMUs[i].libHandle);
        }
        free(inst->FMUs[i].x);
    }
    free(inst->FMUs);
    free(inst);
    wrapperInstance = NULL;
}

