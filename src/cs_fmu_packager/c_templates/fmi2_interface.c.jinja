    fmi2GetContinuousStatesTYPE*      getContinuousStates;
    fmi2GetNominalsOfContinuousStatesTYPE* getNominalsOfContinuousStates;
    fmi2CompletedIntegratorStepTYPE*  completedIntegratorStep;
    /* Continuous state */
    int     nx;
    double* x;
} InternalInstance;

/* ---------------------------------------------------------------------------
 * Wrapper instance
 * --------------------------------------------------------------------------- */
typedef struct {
    /* FMI callbacks */
    fmi2CallbackFunctions*   callbacks;
    fmi2String               instanceName;

    /* Solver parameters */
    double  stepSize;
    double  communicationStepSize;
    double  startTime;
    double  currentTime;

    /* Internal FMU instances */
    int              nFMUs;
    InternalInstance* FMUs;

    /* Variable mappings would go here in the full implementation */

} WrapperInstance;

/* Static instance pointer */
static WrapperInstance* wrapperInstance = NULL;

